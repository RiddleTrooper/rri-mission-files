																							class Attributes
																							{
																								init="if (isServer) then {" \n "    if (isNil ""VLSTurret1"") then { VLSTurret1 = true; publicVariable ""VLSTurret1""; };" \n "};" \n "" \n "if (hasInterface) then {" \n "    this addAction [" \n "        ""Control Mk41 VLS Turret""," \n "        {" \n "            params [""_target"", ""_caller"", ""_actionId"", ""_arguments""];" \n "            VLSTurret1 = false; publicVariable ""VLSTurret1"";" \n "            " \n "            _caller setVariable [""LastTerminalPos"", getPosATL _caller, false];" \n "            _caller setVariable [""LastTerminalDir"", getDir _caller, false];" \n "            _caller enableSimulation false;" \n "            " \n "            [ [_caller, gunner VLS_Gun_1], { (_this select 0) remoteControl (_this select 1); } ] remoteExec [""call"", 2];" \n "            " \n "            private _cam = ""camera"" camCreate (VLS_Gun_1 modelToWorld [0, -12, 6]);" \n "            _cam camSetTarget VLS_Gun_1; _cam camCommit 0; _cam cameraEffect [""internal"", ""BACK""];" \n "            _caller setVariable [""VLSCameraRef"", _cam, false];" \n "            " \n "            private _ehExit = (findDisplay 46) displayAddEventHandler [""KeyDown"", {" \n "                if ((_this select 1) == 1 && {isNull findDisplay 9912}) then {" \n "                    (findDisplay 46) displayRemoveEventHandler [""KeyDown"", player getVariable [""VLSExitEH"", -1]];" \n "                    (findDisplay 46) displayRemoveEventHandler [""MouseButtonDown"", player getVariable [""VLSFireEH"", -1]];" \n "                    [ [gunner VLS_Gun_1], { objNull remoteControl (_this select 0); } ] remoteExec [""call"", 2];" \n "                    " \n "                    private _c = player getVariable [""VLSCameraRef"", objNull];" \n "                    if (!isNull _c) then { _c cameraEffect [""terminate"", ""BACK""]; camDestroy _c; };" \n "                    player switchCamera ""Internal""; player enableSimulation true;" \n "                    " \n "                    player setPosATL (player getVariable [""LastTerminalPos"", getPosATL player]);" \n "                    player setDir (player getVariable [""LastTerminalDir"", getDir player]);" \n "                    VLSTurret1 = true; publicVariable ""VLSTurret1"";" \n "                    true;" \n "                };" \n "                false;" \n "            }];" \n "            _caller setVariable [""VLSExitEH"", _ehExit, false];" \n "            " \n "            private _ehFire = (findDisplay 46) displayAddEventHandler [""MouseButtonDown"", {" \n "                if ((_this select 1) == 0 && {isNull findDisplay 9912}) then {" \n "                    disableSerialization;" \n "                    private _disp = findDisplay 46 createDisplay ""RscDisplayEmpty"";" \n "                    private _ctrl = _disp ctrlCreate [""RscMapControl"", 9912];" \n "                    _ctrl ctrlSetPosition [safeZoneX, safeZoneY, safeZoneW, safeZoneH]; _ctrl ctrlCommit 0;" \n "                    _ctrl ctrlMapAnimAdd [0, 0.1, getPosATL VLS_Gun_1]; ctrlMapAnimCommit _ctrl;" \n "                    " \n "                    _ctrl ctrlAddEventHandler [""MouseButtonDown"", {" \n "                        if ((_this select 1) == 0) then {" \n "                            private _pos = (_this select 0) ctrlMapScreenToWorld [(_this select 2), (_this select 3)];" \n "                            VLS_Gun_1 setVariable [""TargetVector"", _pos, true];" \n "                            " \n "                            [ [], {" \n "                                private _wpn = (weapons VLS_Gun_1) select 0;" \n "                                private _t = createVehicle [""LaserTargetW"", VLS_Gun_1 getVariable ""TargetVector"", [], 0, ""CAN_COLLIDE""];" \n "                                west reportRemoteTarget [_t, 3600]; _t confirmSensorTarget [west, true];" \n "                                (gunner VLS_Gun_1) selectWeapon _wpn; (gunner VLS_Gun_1) fireAtTarget [_t, _wpn];" \n "