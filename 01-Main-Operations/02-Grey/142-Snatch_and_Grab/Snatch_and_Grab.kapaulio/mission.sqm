																							class Attributes
																							{
																								name="VLS_Guidance_Trigger";
																								condition="true";
																								onActivation="VLS_Gun_1 addEventHandler [""Fired"", { " \n "    params [""_unit"", ""_weapon"", ""_muzzle"", ""_mode"", ""_ammo"", ""_magazine"", ""_projectile"", ""_gunner""]; " \n "     " \n "    private _targetPos = _unit getVariable [""TargetVector"", getPosATL _unit]; " \n "     " \n "    [_projectile, _targetPos, getPosATL _unit] spawn { " \n "        params [""_missile"", ""_tPos"", ""_vlsPos""]; " \n "         " \n "        sleep 0.75; " \n "        if (!alive _missile) exitWith {}; " \n "         " \n "        private _skyApex = [ _vlsPos select 0, _vlsPos select 1, 1000 ]; " \n "        private _helperObject = createVehicle [""Land_HelipadEmpty_F"", _skyApex, [], 0, ""CAN_COLLIDE""]; " \n "        _helperObject setPosATL _skyApex; " \n "         " \n "        _missile setMissileTarget [_helperObject, true]; " \n "         " \n "        while { alive _missile && { (_missile distance2D _tPos) > 1000 } } do { " \n "            private _mPos = getPosATL _missile; " \n "            private _angle = ((_tPos select 0) - (_mPos select 0)) atan2 ((_tPos select 1) - (_mPos select 1)); " \n "             " \n "            private _leadPos = [(_mPos select 0) + (sin _angle * 400), (_mPos select 1) + (cos _angle * 400), 1000]; " \n "            _helperObject setPosATL _leadPos; " \n "             " \n "            uiSleep 0.05; " \n "        }; " \n "         " \n "        deleteVehicle _helperObject; " \n "        if (!alive _missile) exitWith {}; " \n "         " \n "        private _strikeTarget = createVehicle [""LaserTargetW"", _tPos, [], 0, ""CAN_COLLIDE""]; " \n "        west reportRemoteTarget [_strikeTarget, 3600]; " \n "        _strikeTarget confirmSensorTarget [west, true]; " \n "         " \n "        _missile setMissileTarget [_strikeTarget, true]; " \n "         " \n "        waitUntil { !alive _missile }; " \n "        deleteVehicle _strikeTarget; " \n "    }; " \n "}]; " \n "";
																								sizeA=0;
																								sizeB=0;
																								repeatable=1;
																							};
